{
  "version": 2,
  "builds": [
    {
      "src": "api/qualities.js",
      "use": "@vercel/node"
    },
    {
      "src": "api/index.js",
      "use": "@vercel/node"
    }
  ],
  "routes": [
    {
      "src": "/api/qualities(.*)",
      "dest": "/api/qualities.js"
    },
    {
      "src": "/api/health",
      "dest": "/api/qualities.js"
    },
    {
      "src": "/(.*)",
      "dest": "/api/index.js"
    }
  ]
}
